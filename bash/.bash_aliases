alias ll="ls -l"
alias la="ls -al"

alias bat="batcat"
alias ld="lazydocker"
alias lg="lazygit"

alias py="python3"
#alias pip="pip3"

alias cve="py -m venv .venv"
alias ave="source ./venv/bin/activate"
alias gave="source $HOME/dev/.venv/bin/activate"
alias dve="deactivate"

alias now='date +"%T"'

alias dev="cd ~/dev/"
alias home="cd ~/"
alias cls="clear"

alias updall="sudo apt update && sudo apt upgrade -y"
