alias ll="ls -lh --color=auto --group-directories-first"
alias la="ls -alh --color=auto --group-directories-first"

alias bat="batcat"
alias ld="lazydocker"
alias lg="lazygit"
alias nv="nvim"

alias py="python3"
#alias pip="pip3"

alias cve="py -m venv .venv"
alias eve="vim .venv/bin/activate"
alias ave="source .venv/bin/activate"
alias gve="source $HOME/dev/.venv/bin/activate"
alias dve="deactivate"

alias dev="cd ~/dev/"
alias home="cd ~/"
alias work="cd ~/workspace/"

alias cls="clear"
alias now='date +"%T"'

alias updall="sudo apt update && sudo apt upgrade -y"

alias cfg="vim $HOME/.bash_aliases"
alias nvcfg="nvim $HOME/.config/nvim/init.lua"
alias recfg="source $HOME/.bashrc"

alias df="df -h"
alias free="free -m"
alias grep="grep --color=auto"
